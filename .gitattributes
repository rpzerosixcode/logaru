# Set default behavior: treat everything not listed as text and normalize to LF.
* text=auto eol=lf

# --- Ruby sources: always LF, not diff-able in binary way -----------------
*.rb text eol=lf
*.rake text eol=lf
Gemfile text eol=lf
Rakefile text eol=lf
*.gemspec text eol=lf

# --- Executables: force LF, keep executable bit on Unix -------------------
bin/* text eol=lf

# --- Markdown and docs ----------------------------------------------------
*.md text eol=lf
*.txt text eol=lf
docs/** text eol=lf

# --- Config / meta files --------------------------------------------------
*.yml text eol=lf
*.yaml text eol=lf
.github/dependabot.yml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.rspec text eol=lf
LICENSE text eol=lf

# --- Shell scripts --------------------------------------------------------
*.sh text eol=lf

# --- Windows scripts: must keep CRLF --------------------------------------
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# --- Binary assets (never diff, never normalize) --------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gem binary
*.zip binary

# --- Generated diffs / linguist hints -------------------------------------
vendor/** linguist-vendored
docs/** linguist-documentation
spec/** linguist-language=Ruby
